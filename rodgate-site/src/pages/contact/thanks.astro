---
import Base from '../../layouts/Base.astro';
import { company } from '../../data/company.js';
---
<Base title="Request received" description="Your request has been received.">
  <section class="section">
    <div class="container narrow ty">
      <hr class="rule-open" />
      <p class="eyebrow">Confirmation</p>
      <h1 class="ty__title">Request received.</h1>
      <p class="ty__body">
        Thank you. We have your request and will respond promptly.
        <br />If it is urgent, call {company.poc} directly at
        {' '}<a href={`tel:${company.phoneHref}`} class="link mono">{company.phone}</a>.
      </p>
      <a href="/" class="btn btn-primary ty__btn">Back to home</a>
    </div>
  </section>
</Base>

<style>
  .ty { padding-block: var(--space-16); }
  .ty__title { margin-top: var(--space-2); font-size: clamp(31px, 4vw, 45px); }
  .ty__body {
    margin-top: var(--space-4);
    font-family: var(--font-body); font-size: var(--text-lg); color: var(--color-text-muted);
  }
  .ty__btn { margin-top: var(--space-8); }
</style>
