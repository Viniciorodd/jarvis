---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { company } from '../data/company.js';
---
<Base title="About" description="Rodgate Group is an owner-managed janitorial and facilities support contractor in Nanticoke, Pennsylvania.">
  <PageHeader
    eyebrow="About"
    title="Owner-managed, and it shows"
    lead="No account layer. No call centre. The person accountable for the work is the person you reach."
  />

  <section class="section">
    <div class="container about">
      <div class="about__main">
        <p class="about__p">
          {company.legalName}, doing business as {company.dba}, is a janitorial and
          facilities support contractor based in Nanticoke, Pennsylvania. We serve
          federal, state, and local government across {company.serviceArea.join(', ')}.
        </p>
        <p class="about__p">
          The work is custodial and janitorial, grounds and landscaping, trash and
          haul-away, and broader facilities support. We coordinate vetted regional crews
          and size them to the requirement. Scope is agreed in writing before anyone
          starts.
        </p>
        <p class="about__p">
          We are a small company and we are early. We would rather be the contractor that
          never surprises you than the one with the longest brochure. That means we claim
          only the classifications we hold, we list only past performance we can
          substantiate, and we price once and stand behind it.
        </p>

        <hr class="rule-hair about__sep" />

        <p class="eyebrow">Classifications held</p>
        <div class="about__pills">
          {company.status.map((s) => <span class="badge">{s}</span>)}
        </div>
      </div>

      <aside class="card about__card">
        <p class="eyebrow about__cardh">Point of contact</p>
        <p class="about__poc">{company.poc}</p>
        <p class="about__role">{company.pocTitle}</p>
        <hr class="rule-hair about__sep2" />
        <table class="spec">
          <tbody>
            <tr><th scope="row">Email</th><td><a href={`mailto:${company.email}`} class="link">{company.email}</a></td></tr>
            <tr><th scope="row">Phone</th><td><a href={`tel:${company.phoneHref}`} class="link">{company.phone}</a></td></tr>
            <tr><th scope="row">Address</th><td class="prose">{company.address}</td></tr>
            <tr><th scope="row">Entity</th><td class="prose">{company.businessType}</td></tr>
          </tbody>
        </table>
      </aside>
    </div>
  </section>
</Base>

<style>
  .about { display: grid; gap: var(--space-12); align-items: start; }
  @media (min-width: 940px) { .about { grid-template-columns: 1.25fr 0.75fr; gap: var(--space-16); } }
  .about__p {
    font-family: var(--font-body); font-size: var(--text-lg);
    line-height: 1.7; max-width: var(--measure);
  }
  .about__p + .about__p { margin-top: var(--space-5); }
  .about__sep { margin-block: var(--space-8); }
  .about__pills { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-4); }

  .about__card { padding: var(--space-6); }
  .about__cardh { display: block; }
  .about__poc {
    margin-top: var(--space-3);
    font-family: var(--font-display); font-weight: 700; font-size: var(--text-xl);
    letter-spacing: var(--tracking-tight);
  }
  .about__role { font-family: var(--font-body); color: var(--color-text-muted); }
  .about__sep2 { margin-block: var(--space-5); }
</style>
