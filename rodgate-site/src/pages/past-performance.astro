---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import { company } from '../data/company.js';

// Voice rule: never overstate past performance. A bracketed placeholder is
// correct; generic filler prose is not. Real contracts drop in here.
const contracts = [];

const posture = [
  { k: 'Federal', v: 'Responding to facilities, janitorial, and grounds sources-sought and solicitations as a small-business prime and subcontractor.' },
  { k: 'State and cooperative', v: 'Commonwealth of Pennsylvania procurement vendor and COSTARS cooperative member.' },
  { k: 'Teaming', v: `Building prime relationships across ${company.serviceAreaAbbr.join(', ')} to carry custodial and grounds scope under established past performance.` },
];
---
<Base title="Past performance" description="Rodgate Group is building past performance across PA, NJ, NY, and FL federal, state, and local facilities contracts.">
  <PageHeader
    eyebrow="Past performance"
    title="Only verified contracts are listed"
    lead="Rodgate is a young company. We would rather show you an honest record than a padded one — this page lists what we can substantiate, and nothing else."
  />

  <section class="section">
    <div class="container">
      {contracts.length === 0 ? (
        <div class="card empty">
          <p class="eyebrow">Current status</p>
          <h2 class="empty__title">No awarded contracts listed at this time.</h2>
          <p class="empty__body">
            We are actively building past performance across
            {' '}{company.serviceAreaAbbr.join('/')} federal, state, and local facilities work.
            <br />When a contract closes and can be verified, it appears here with the agency,
            the scope, the period, and a reference — not before.
          </p>

          <hr class="rule-hair empty__sep" />

          <p class="eyebrow">Where we stand</p>
          <table class="spec empty__spec">
            <tbody>
              {posture.map((p) => (
                <tr><th scope="row">{p.k}</th><td class="prose">{p.v}</td></tr>
              ))}
            </tbody>
          </table>

          <hr class="rule-hair empty__sep" />

          <p class="eyebrow">What a prime can rely on today</p>
          <ul class="empty__list">
            {[
              'Owner-managed — one point of contact, accountable for the work',
              'Crews sized to the requirement, not to a template',
              'Active SAM registration and PA Commonwealth / COSTARS vendor status',
              'Scope agreed in writing before work begins',
            ].map((i) => (
              <li><Icon name="check" size={15} stroke={1.75} /><span>{i}</span></li>
            ))}
          </ul>
        </div>
      ) : (
        <div class="grid">
          {contracts.map((c) => (
            <article class="card contract">
              <h2>{c.agency}</h2>
              <p>{c.scope}</p>
            </article>
          ))}
        </div>
      )}

      <div class="cta">
        <h2 class="cta__title">Considering Rodgate as a subcontractor?</h2>
        <a href="/contact" class="btn btn-accent">Start a conversation</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .empty { padding: var(--space-10); }
  .empty__title { margin-top: var(--space-3); font-size: var(--text-2xl); max-width: 24ch; }
  .empty__body {
    margin-top: var(--space-4); max-width: 66ch;
    font-family: var(--font-body); font-size: var(--text-lg); color: var(--color-text-muted);
  }
  .empty__sep { margin-block: var(--space-8); }
  .empty__spec { margin-top: var(--space-4); }
  .empty__list { list-style: none; margin: var(--space-4) 0 0; padding: 0; }
  .empty__list li {
    display: flex; gap: var(--space-3); padding-block: 6px;
    font-family: var(--font-body); font-size: var(--text-base);
  }
  .empty__list li :global(svg) { color: var(--bronze-600); flex: none; margin-top: 5px; }

  .cta {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
    gap: var(--space-5);
    background: var(--stone-100);
    border-top: 3px solid var(--slate-700);
    padding: var(--space-8);
    margin-top: var(--space-8);
  }
  .cta__title { font-size: var(--text-xl); }
</style>
