---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CapabilityTable from '../components/CapabilityTable.astro';
import Icon from '../components/Icon.astro';
import { company } from '../data/company.js';
---
<Base title="Capability statement" description="Rodgate Group capability statement: UEI, CAGE, NAICS, PSC/FSC, socio-economic status, SAM.gov registration, and service area.">
  <PageHeader
    eyebrow="Capability statement"
    title="Company data and registrations"
    lead="Everything a contracting officer or a prime's procurement office needs to qualify us. Built to print and photocopy cleanly."
  />

  <section class="section">
    <div class="container">
      <div class="intro">
        <p class="intro__text">
          {company.legalName} is registered in SAM with an active All Awards registration
          through February 2027, and is a Commonwealth of Pennsylvania procurement vendor.
          <br />Every code below is exact. Nothing is claimed that is not held.
        </p>
        <a href={company.capabilityPdf} download class="btn btn-accent no-print">
          <Icon name="download" size={14} stroke={1.75} /> Download PDF
        </a>
      </div>

      <CapabilityTable />

      <div class="notes">
        <div class="card notes__card">
          <p class="eyebrow">Classifications held</p>
          <div class="notes__pills">
            {company.status.map((s) => <span class="badge">{s}</span>)}
          </div>
          <p class="notes__body">
            Self-certified. Rodgate does not hold and does not claim 8(a), HUBZone,
            SDVOSB, or WOSB status.
          </p>
        </div>
        <div class="card notes__card">
          <p class="eyebrow">Service area</p>
          <div class="notes__pills">
            {company.serviceArea.map((s) => <span class="badge">{s}</span>)}
          </div>
          <p class="notes__body">{company.bonding}</p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .intro {
    display: flex; flex-wrap: wrap; align-items: flex-start;
    justify-content: space-between; gap: var(--space-6);
    margin-bottom: var(--space-8);
  }
  .intro__text {
    max-width: 62ch;
    font-family: var(--font-body); font-size: var(--text-lg); color: var(--color-text-muted);
  }
  .notes { display: grid; gap: var(--space-6); margin-top: var(--space-8); }
  @media (min-width: 780px) { .notes { grid-template-columns: 1fr 1fr; } }
  .notes__card { padding: var(--space-6); }
  .notes__pills { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-4); }
  .notes__body {
    margin-top: var(--space-4);
    font-family: var(--font-body); font-size: var(--text-base); color: var(--color-text-muted);
  }
</style>
