---
const { eyebrow, title, lead } = Astro.props;
---
<section class="ph surface-inverse">
  <div class="container ph__inner">
    <hr class="rule-open" />
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1 class="ph__title">{title}</h1>
    {lead && <p class="ph__lead">{lead}</p>}
  </div>
</section>

<style>
  .ph { background: var(--slate-800); border-bottom: 3px solid var(--bronze-600); }
  .ph__inner { padding-block: var(--space-16); }
  .ph__title {
    margin-top: var(--space-2);
    font-size: clamp(31px, 4.2vw, 45px);
    color: #fff;
    max-width: 20ch;
  }
  .ph__lead {
    margin-top: var(--space-4);
    max-width: 60ch;
    font-family: var(--font-body);
    font-size: var(--text-xl);
    line-height: 1.55;
    color: var(--inverse-muted);
  }
</style>
