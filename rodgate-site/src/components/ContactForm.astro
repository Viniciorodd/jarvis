---
// Netlify Forms. Notifications route to vinicio@rodgategroup.com
// (set in Netlify dashboard → Forms → capability-briefing).
---
<form
  name="capability-briefing"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  action="/contact/thanks"
  class="card cf"
>
  <input type="hidden" name="form-name" value="capability-briefing" />
  <p hidden><label>Leave blank: <input name="bot-field" /></label></p>

  <div class="cf__grid">
    <label>
      <span class="field-label">Name <abbr title="required">*</abbr></span>
      <input class="input" type="text" name="name" required autocomplete="name" />
    </label>
    <label>
      <span class="field-label">Organization</span>
      <input class="input" type="text" name="organization" autocomplete="organization" />
    </label>
    <label>
      <span class="field-label">Email <abbr title="required">*</abbr></span>
      <input class="input" type="email" name="email" required autocomplete="email" />
    </label>
    <label>
      <span class="field-label">Requirement</span>
      <select class="input" name="requirement">
        <option>Custodial &amp; janitorial</option>
        <option>Grounds &amp; landscaping</option>
        <option>Trash &amp; haul-away</option>
        <option>Facilities support</option>
        <option>Subcontracting / teaming</option>
        <option>Other</option>
      </select>
    </label>
  </div>

  <label class="cf__full">
    <span class="field-label">Scope</span>
    <textarea class="input" name="message" rows="5"
      placeholder="The buildings, the square footage, and the frequency."></textarea>
    <span class="cf__hint">Tell us those three and you get a price and a staffing plan — once, in writing.</span>
  </label>

  <button type="submit" class="btn btn-accent cf__submit">Send request</button>
</form>

<style>
  .cf { padding: var(--space-8); }
  .cf__grid { display: grid; gap: var(--space-5); }
  @media (min-width: 620px) { .cf__grid { grid-template-columns: 1fr 1fr; } }
  .cf__full { display: block; margin-top: var(--space-5); }
  .cf__hint {
    display: block; margin-top: var(--space-2);
    font-family: var(--font-ui); font-size: var(--text-xs); color: var(--slate-500);
  }
  .cf__submit { margin-top: var(--space-6); }
  abbr { color: var(--red-600); text-decoration: none; }
</style>
