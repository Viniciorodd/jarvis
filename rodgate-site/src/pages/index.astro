---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import { services, differentiators, company } from '../data/company.js';
---
<Base>
  <Hero />

  <!-- Core competencies -->
  <section class="section">
    <div class="container">
      <SectionHeading
        eyebrow="What we do"
        title="Core competencies"
        lead="Four service lines under one point of accountability. We coordinate vetted regional crews and stand behind the work."
      />

      <div class="svc">
        {services.map((s, i) => (
          <a href={`/services#${s.slug}`} class="svc__row">
            <span class="svc__num mono">{String(i + 1).padStart(2, '0')}</span>
            <span class="svc__icon"><Icon name={s.icon} size={22} stroke={1.75} /></span>
            <span class="svc__body">
              <span class="svc__name">{s.name}</span>
              <span class="svc__desc">{s.short}</span>
            </span>
            <span class="svc__go"><Icon name="arrow-right" size={16} stroke={1.75} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Rodgate -->
  <section class="section surface-sunken">
    <div class="container">
      <SectionHeading eyebrow="Why Rodgate" title="What you can hold us to" />
      <div class="diff">
        {differentiators.map((d) => (
          <div class="diff__item">
            <h3 class="diff__title">{d.title}</h3>
            <p class="diff__body">{d.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Capability statement -->
  <section class="section">
    <div class="container cap">
      <div>
        <SectionHeading
          eyebrow="Capability statement"
          title="Everything needed to qualify us, on one page."
          lead="Registrations, codes, classifications, and service area — laid out to print or photocopy without losing a thing."
        />
        <div class="cap__cta">
          <a href="/capabilities" class="btn btn-primary">Company data</a>
          <a href={company.capabilityPdf} download class="btn btn-secondary">
            <Icon name="download" size={14} stroke={1.75} /> Download PDF
          </a>
        </div>
      </div>

      <aside class="card cap__panel">
        <p class="eyebrow cap__panel-h">At a glance</p>
        <table class="spec">
          <tbody>
            <tr><th scope="row">Legal name</th><td class="prose">{company.legalName}</td></tr>
            <tr><th scope="row">UEI</th><td>{company.uei}</td></tr>
            <tr><th scope="row">CAGE</th><td>{company.cage}</td></tr>
            <tr><th scope="row">NAICS</th><td>{company.naics.map((n) => n.code).join('  ·  ')}</td></tr>
            <tr><th scope="row">Service area</th><td>{company.serviceAreaAbbr.join('  ·  ')}</td></tr>
          </tbody>
        </table>
      </aside>
    </div>
  </section>
</Base>

<style>
  .svc { margin-top: var(--space-12); border-top: 1px solid var(--border-hairline); }
  .svc__row {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    align-items: start;
    gap: var(--space-5);
    padding: var(--space-6) var(--space-2);
    border-bottom: 1px solid var(--border-hairline);
    transition: background var(--dur-3) var(--ease);
  }
  .svc__row:hover { background: var(--white); }
  .svc__num { font-size: var(--text-xs); color: var(--bronze-600); padding-top: 4px; }
  .svc__icon { color: var(--slate-500); padding-top: 1px; }
  .svc__body { display: block; }
  .svc__name {
    display: block;
    font-family: var(--font-display); font-weight: 700;
    font-size: var(--text-xl); letter-spacing: var(--tracking-tight);
  }
  .svc__desc {
    display: block; margin-top: 4px; max-width: 62ch;
    font-family: var(--font-body); font-size: var(--text-base); color: var(--color-text-muted);
  }
  .svc__go { color: var(--slate-400); padding-top: 6px; }
  .svc__row:hover .svc__go { color: var(--bronze-600); }

  .diff { display: grid; gap: var(--space-8); margin-top: var(--space-12); }
  @media (min-width: 720px) { .diff { grid-template-columns: 1fr 1fr; gap: var(--space-10); } }
  .diff__item { border-top: 3px solid var(--slate-700); padding-top: var(--space-4); }
  .diff__title { font-size: var(--text-lg); }
  .diff__body {
    margin-top: var(--space-2); max-width: 52ch;
    font-family: var(--font-body); font-size: var(--text-base); color: var(--color-text-muted);
  }

  .cap { display: grid; gap: var(--space-12); align-items: start; }
  @media (min-width: 940px) { .cap { grid-template-columns: 1.1fr 0.9fr; gap: var(--space-16); } }
  .cap__cta { margin-top: var(--space-8); display: flex; flex-wrap: wrap; gap: var(--space-3); }
  .cap__panel { padding: var(--space-6); }
  .cap__panel-h { display: block; margin-bottom: var(--space-4); }
</style>
