---
import Logo from './Logo.astro';
import { nav, SHOW_MARK } from '../data/company.js';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="nav surface-inverse no-print">
  <div class="container nav__bar">
    <a href="/" aria-label="Rodgate Group — home">
      <Logo showMark={SHOW_MARK} tone="white" size={30} />
    </a>

    <nav class="nav__links" aria-label="Primary">
      {nav.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}
           class:list={['nav__link', isActive(item.href) && 'is-active']}>{item.label}</a>
      ))}
      <!-- inverse, not accent: the page's own primary action owns the single
           bronze button per view (Button rule: never more than one accent). -->
      <a href="/contact" class="btn btn-inverse nav__cta">Request a briefing</a>
    </nav>

    <button id="nav-toggle" type="button" class="nav__burger"
      aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
        stroke-width="1.75" stroke-linecap="round" aria-hidden="true">
        <path d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <nav id="mobile-nav" hidden aria-label="Mobile" class="nav__mobile">
    <div class="container">
      {nav.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}
           class:list={['nav__mlink', isActive(item.href) && 'is-active']}>{item.label}</a>
      ))}
    </div>
  </nav>
</header>

<style>
  .nav { border-bottom: 3px solid var(--bronze-600); }
  .nav__bar {
    display: flex; align-items: center; justify-content: space-between;
    gap: var(--space-6); padding-block: var(--space-4);
  }
  .nav__links { display: none; align-items: center; gap: var(--space-6); }
  @media (min-width: 900px) { .nav__links { display: flex; } }

  .nav__link {
    font-family: var(--font-ui);
    font-size: var(--text-2xs);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--inverse-muted);
    padding-bottom: 3px;
    border-bottom: 2px solid transparent;
    transition: color var(--dur-2) var(--ease), border-color var(--dur-2) var(--ease);
  }
  .nav__link:hover { color: var(--inverse-text); }
  .nav__link.is-active { color: #fff; border-bottom-color: var(--bronze-500); }

  .nav__cta { margin-left: var(--space-2); padding: 10px 16px; }

  .nav__burger {
    display: grid; place-items: center;
    width: 38px; height: 38px;
    background: transparent; color: var(--inverse-text);
    border: 1px solid var(--inverse-hairline); border-radius: var(--radius-md);
    cursor: pointer;
  }
  @media (min-width: 900px) { .nav__burger { display: none; } }

  .nav__mobile { border-top: 1px solid var(--inverse-hairline); padding-block: var(--space-2); }
  .nav__mlink {
    display: block;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--inverse-muted);
    padding: 11px 0;
    border-bottom: 1px solid var(--inverse-hairline);
  }
  .nav__mobile .container > .nav__mlink:last-child { border-bottom: 0; }
  .nav__mlink.is-active { color: #fff; }
</style>

<script>
  const t = document.getElementById('nav-toggle');
  const m = document.getElementById('mobile-nav');
  t?.addEventListener('click', () => {
    const opening = m?.hasAttribute('hidden');
    if (opening) m?.removeAttribute('hidden'); else m?.setAttribute('hidden', '');
    t.setAttribute('aria-expanded', String(!!opening));
  });
</script>
