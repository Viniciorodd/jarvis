---
import { company } from '../data/company.js';
// Flat --slate-800. No gradient, no photo, no pattern, no texture.
// A 3px bronze bottom rule closes the band. That is the whole treatment.
const reg = [
  ['UEI', company.uei],
  ['CAGE', company.cage],
  ['NAICS', company.naics.map((n) => n.code).join('  ·  ')],
  ['SAM.gov', 'Active — All Awards, through Feb 2027'],
  ['State', 'PA Commonwealth vendor · COSTARS'],
];
---
<section class="hero surface-inverse">
  <div class="container hero__grid">
    <div>
      <div class="hero__badges">
        <span class="badge">Small Business</span>
        <span class="badge">Small Disadvantaged (self-certified)</span>
        <span class="badge">Minority-Owned · Hispanic American Owned</span>
      </div>

      <h1 class="display hero__title">Facilities kept to standard, on contract.</h1>

      <p class="hero__body">
        {company.legalName} is an owner-managed janitorial and facilities support
        contractor serving federal, state, and local government in
        {' '}{company.serviceArea.join(', ')}.
        <br />Crews are sized to the requirement. The owner answers the phone.
      </p>

      <div class="hero__cta">
        <a href="/contact" class="btn btn-accent">Request a capability briefing</a>
        <a href="/capabilities" class="btn btn-inverse">Capability statement</a>
      </div>
    </div>

    <aside class="hero__panel card-inverse card-accent-edge">
      <p class="eyebrow hero__panel-title">Registration on file</p>
      <table class="spec">
        <tbody>
          {reg.map(([k, v]) => (
            <tr><th scope="row">{k}</th><td>{v}</td></tr>
          ))}
        </tbody>
      </table>
    </aside>
  </div>
</section>

<style>
  .hero {
    background: var(--slate-800);
    border-bottom: 3px solid var(--bronze-600);
  }
  .hero__grid {
    display: grid;
    gap: var(--space-12);
    padding-block: var(--space-20);
    align-items: start;
  }
  @media (min-width: 940px) {
    .hero__grid { grid-template-columns: 1.15fr 0.85fr; gap: var(--space-16); }
  }

  .hero__badges { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-8); }
  .hero__title { color: #fff; max-width: 15ch; }
  .hero__body {
    margin-top: var(--space-6);
    max-width: 54ch;
    font-family: var(--font-body);
    font-size: var(--text-xl);
    line-height: 1.55;
    color: var(--inverse-muted);
  }
  .hero__cta { margin-top: var(--space-8); display: flex; flex-wrap: wrap; gap: var(--space-3); }

  .hero__panel { padding: var(--space-6); }
  .hero__panel-title { display: block; margin-bottom: var(--space-4); }
</style>
