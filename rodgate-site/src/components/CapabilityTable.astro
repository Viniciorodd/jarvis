---
// SpecTable — the verified-facts table is the single most-read element in
// the whole brand. Codes are monospaced and exact, never prettified.
import { company } from '../data/company.js';

const rows = [
  ['Legal name', `${company.legalName} (DBA ${company.dba})`, true],
  ['UEI', company.uei],
  ['CAGE', company.cage],
  ['NAICS', company.naics.map((n) => `${n.code}${n.primary ? ' (primary)' : ''}`).join('  ·  ')],
  ['PSC / FSC', company.psc.join(', ')],
  ['Socio-economic', null],
  ['SAM.gov', company.sam, true],
  ['State pipeline', company.statePipeline, true],
  ['Service area', company.serviceArea.join(' · '), true],
  ['Bonding', company.bonding, true],
  ['Business type', company.businessType, true],
  ['Point of contact', `${company.poc}, ${company.pocTitle}`, true],
  ['Email', company.email],
  ['Phone', company.phone],
  ['Address', company.address, true],
];
---
<div class="spec-wrap card">
  <table class="spec">
    <caption class="sr-only">Rodgate Group capability statement and company data</caption>
    <tbody>
      {rows.map(([k, v, prose]) => (
        <tr>
          <th scope="row">{k}</th>
          <td class={prose ? 'prose' : undefined}>
            {k === 'Socio-economic' ? (
              <div class="pills">{company.status.map((s) => <span class="badge">{s}</span>)}</div>
            ) : k === 'Email' ? (
              <a href={`mailto:${company.email}`} class="link">{v}</a>
            ) : k === 'Phone' ? (
              <a href={`tel:${company.phoneHref}`} class="link">{v}</a>
            ) : v}
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .spec-wrap { overflow-x: auto; }
  .pills { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
</style>
