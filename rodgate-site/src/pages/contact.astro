---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import { company } from '../data/company.js';
---
<Base title="Contact" description="Request a capability briefing from Rodgate Group. Serving federal, state, and local government in PA, NJ, NY, and FL.">
  <PageHeader
    eyebrow="Contact"
    title="Request a capability briefing"
    lead="Tell us the buildings, the square footage, and the frequency. You get a price and a staffing plan — once, in writing."
  />

  <section class="section">
    <div class="container ct">
      <ContactForm />

      <aside class="ct__side">
        <div class="card ct__card">
          <p class="eyebrow ct__h">Direct</p>
          <p class="ct__poc">{company.poc}</p>
          <p class="ct__role">{company.pocTitle}</p>
          <hr class="rule-hair ct__sep" />
          <table class="spec">
            <tbody>
              <tr><th scope="row">Email</th><td><a href={`mailto:${company.email}`} class="link">{company.email}</a></td></tr>
              <tr><th scope="row">Phone</th><td><a href={`tel:${company.phoneHref}`} class="link">{company.phone}</a></td></tr>
              <tr><th scope="row">Address</th><td class="prose">{company.address}</td></tr>
            </tbody>
          </table>
        </div>

        <div class="card ct__card">
          <p class="eyebrow ct__h">Service area</p>
          <div class="ct__pills">
            {company.serviceArea.map((s) => <span class="badge">{s}</span>)}
          </div>
        </div>

        <div class="card ct__card">
          <p class="eyebrow ct__h">Registration</p>
          <table class="spec">
            <tbody>
              <tr><th scope="row">UEI</th><td>{company.uei}</td></tr>
              <tr><th scope="row">CAGE</th><td>{company.cage}</td></tr>
              <tr><th scope="row">SAM.gov</th><td class="prose">Active — All Awards</td></tr>
            </tbody>
          </table>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .ct { display: grid; gap: var(--space-10); align-items: start; }
  @media (min-width: 940px) { .ct { grid-template-columns: 1.3fr 0.7fr; gap: var(--space-12); } }
  .ct__side { display: grid; gap: var(--space-5); }
  .ct__card { padding: var(--space-6); }
  .ct__h { display: block; }
  .ct__poc {
    margin-top: var(--space-3);
    font-family: var(--font-display); font-weight: 700; font-size: var(--text-lg);
  }
  .ct__role { font-family: var(--font-body); font-size: var(--text-base); color: var(--color-text-muted); }
  .ct__sep { margin-block: var(--space-5); }
  .ct__pills { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-4); }
</style>
