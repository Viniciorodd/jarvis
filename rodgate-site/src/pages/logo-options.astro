---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
// Internal comparison page — not linked in nav. For choosing between the
// keystone mark and a plain-type wordmark. Delete once the call is made.
---
<Base title="Logo options" description="Internal: keystone mark vs plain wordmark.">
  <section class="section">
    <div class="container">
      <hr class="rule-open" />
      <p class="eyebrow">Internal — not linked in navigation</p>
      <h1 class="h2 top">Keep the keystone mark, or drop it?</h1>
      <p class="lead measure sub">
        Option A uses the keystone mark. Option B is the plain-type wordmark.
        Both are shown at real sizes, on both surfaces, and in 1-colour — because
        that is where the decision actually gets tested.
      </p>

      <div class="cols">
        <!-- ── Option A ─────────────────────────────────── -->
        <div>
          <div class="opt-h">
            <span class="badge">Option A</span>
            <h2 class="opt-t">With keystone mark</h2>
          </div>
          <p class="opt-d">
            A keystone tapering downward with an arch opening cut from its base.
            "Gate" in the name; the keystone is Pennsylvania's own emblem. One closed
            path — holds at 16px, survives fax, embroiders in two threads.
          </p>

          <div class="spec-strip">
            <div class="sw sw--paper"><Logo showMark={true} tone="slate" size={34} /></div>
            <div class="sw sw--slate"><Logo showMark={true} tone="white" size={34} /></div>
            <div class="sw sw--paper"><Logo showMark={true} tone="bronze" size={34} /></div>
            <div class="sw sw--paper sizes">
              <Logo showMark={true} tone="slate" size={44} sub={false} />
              <Logo showMark={true} tone="slate" size={26} sub={false} />
              <Logo showMark={true} tone="slate" size={16} sub={false} />
            </div>
          </div>
        </div>

        <!-- ── Option B ─────────────────────────────────── -->
        <div>
          <div class="opt-h">
            <span class="badge">Option B</span>
            <h2 class="opt-t">Wordmark only</h2>
          </div>
          <p class="opt-d">
            RODGATE set in Archivo 700 at +0.18em. No mark to defend, nothing to
            reproduce badly at small sizes. The system still works completely —
            every other asset is unchanged.
          </p>

          <div class="spec-strip">
            <div class="sw sw--paper"><Logo showMark={false} tone="slate" size={34} /></div>
            <div class="sw sw--slate"><Logo showMark={false} tone="white" size={34} /></div>
            <div class="sw sw--paper"><Logo showMark={false} tone="bronze" size={34} /></div>
            <div class="sw sw--paper sizes">
              <Logo showMark={false} tone="slate" size={44} sub={false} />
              <Logo showMark={false} tone="slate" size={26} sub={false} />
              <Logo showMark={false} tone="slate" size={16} sub={false} />
            </div>
          </div>
        </div>
      </div>

      <div class="how">
        <p class="eyebrow">To switch</p>
        <p class="how__body">
          One line — <span class="mono">SHOW_MARK</span> in
          {' '}<span class="mono">src/data/company.js</span>. It drives the nav, the footer,
          and every lockup on the site.
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  .top { margin-top: var(--space-2); }
  .sub { margin-top: var(--space-4); }
  .cols { display: grid; gap: var(--space-12); margin-top: var(--space-12); }
  @media (min-width: 900px) { .cols { grid-template-columns: 1fr 1fr; gap: var(--space-10); } }

  .opt-h { display: flex; align-items: center; gap: var(--space-3); }
  .opt-t { font-size: var(--text-xl); }
  .opt-d {
    margin-top: var(--space-3); max-width: 48ch;
    font-family: var(--font-body); font-size: var(--text-base); color: var(--color-text-muted);
  }
  .spec-strip {
    margin-top: var(--space-6);
    border: 1px solid var(--border-hairline);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .sw { padding: var(--space-8); display: flex; justify-content: center; }
  .sw + .sw { border-top: 1px solid var(--border-hairline); }
  .sw--paper { background: var(--white); }
  .sw--slate { background: var(--slate-800); }
  .sizes { gap: var(--space-8); align-items: center; flex-wrap: wrap; }

  .how {
    margin-top: var(--space-16);
    background: var(--stone-100);
    border-top: 3px solid var(--slate-700);
    padding: var(--space-6);
  }
  .how__body { margin-top: var(--space-2); font-family: var(--font-body); }
</style>
