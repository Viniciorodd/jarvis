---
import Logo from './Logo.astro';
import { company, nav, SHOW_MARK } from '../data/company.js';
const year = new Date().getFullYear();
---
<footer class="ft surface-inverse">
  <div class="container ft__grid">
    <div>
      <Logo showMark={SHOW_MARK} tone="white" size={30} />
      <p class="ft__blurb">
        Owner-managed janitorial and facilities support for federal, state, and
        local government in {company.serviceAreaAbbr.join(', ')}.
      </p>
      <dl class="ft__codes">
        <div><dt>UEI</dt><dd class="mono">{company.uei}</dd></div>
        <div><dt>CAGE</dt><dd class="mono">{company.cage}</dd></div>
      </dl>
    </div>

    <nav aria-label="Footer">
      <p class="eyebrow ft__h">Company</p>
      <ul class="ft__list">
        {nav.map((i) => <li><a href={i.href}>{i.label}</a></li>)}
      </ul>
    </nav>

    <div>
      <p class="eyebrow ft__h">Contact</p>
      <ul class="ft__list">
        <li>{company.poc}, {company.pocTitle}</li>
        <li><a href={`mailto:${company.email}`}>{company.email}</a></li>
        <li><a href={`tel:${company.phoneHref}`} class="mono">{company.phone}</a></li>
        <li>{company.address}</li>
      </ul>
    </div>
  </div>

  <div class="container">
    <hr class="ft__rule" />
    <div class="ft__base">
      <p>© {year} {company.legalName} (DBA {company.dba}). All rights reserved.</p>
      <p>Small Business · Small Disadvantaged (self-certified) · Minority-Owned · Hispanic American Owned</p>
    </div>
  </div>
</footer>

<style>
  .ft { background: var(--slate-900); margin-top: var(--space-24); }
  .ft__grid {
    display: grid; gap: var(--space-10);
    padding-block: var(--space-16) var(--space-10);
  }
  @media (min-width: 800px) { .ft__grid { grid-template-columns: 1.6fr 1fr 1.2fr; } }

  .ft__blurb {
    margin-top: var(--space-5); max-width: 42ch;
    font-family: var(--font-body); font-size: var(--text-base);
    color: var(--inverse-muted);
  }
  .ft__codes { display: flex; gap: var(--space-8); margin: var(--space-6) 0 0; }
  .ft__codes dt {
    font-family: var(--font-ui); font-size: var(--text-2xs); font-weight: 600;
    letter-spacing: var(--tracking-caps); text-transform: uppercase; color: var(--bronze-400);
  }
  .ft__codes dd { margin: 3px 0 0; font-size: var(--text-sm); color: var(--inverse-text); }

  .ft__h { display: block; margin-bottom: var(--space-4); }
  .ft__list { list-style: none; margin: 0; padding: 0; }
  .ft__list li {
    font-family: var(--font-body); font-size: var(--text-base);
    color: var(--inverse-muted); padding-block: 5px;
  }
  .ft__list a { transition: color var(--dur-2) var(--ease); }
  .ft__list a:hover { color: #fff; }

  .ft__rule { border: 0; border-top: 1px solid var(--inverse-hairline); margin: 0; }
  .ft__base {
    display: flex; flex-wrap: wrap; gap: var(--space-3) var(--space-8);
    justify-content: space-between;
    padding-block: var(--space-6);
    font-family: var(--font-ui); font-size: var(--text-2xs);
    color: var(--slate-400);
  }
</style>
